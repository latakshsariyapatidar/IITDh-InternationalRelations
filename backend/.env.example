# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ── Authentication ──────────────────────────────────────────────────────────
# Signs access tokens. Minimum 32 characters, and the placeholder value below
# is rejected outright. Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-me-openssl-rand-base64-48

# Signs the document links written into exported spreadsheets. Optional —
# falls back to JWT_SECRET — but keeping it separate means rotating your token
# signing key does not also break every link in an already-downloaded sheet.
EXPORT_LINK_SECRET=

# ── Browser-facing configuration ────────────────────────────────────────────
# Origins allowed to call this API with credentials. Comma-separated if the
# public site and admin panel are served from different hosts. No trailing slash.
CORS_ORIGIN=http://localhost:5173

# Refresh-cookie attributes.
#   lax    — correct whenever the frontend and API share a registrable domain,
#            including two localhost ports and two subdomains of iitdh.ac.in.
#   none   — only if the frontend is on a genuinely different site. Requires
#            COOKIE_SECURE=true and HTTPS, or browsers discard the cookie.
COOKIE_SAMESITE=lax
# Defaults to true when NODE_ENV=production. Leave unset unless you are
# deliberately overriding it.
COOKIE_SECURE=

# How many reverse proxies (nginx, a load balancer, Cloudflare) sit in front of
# this process. Rate limits key on the client IP, so behind a proxy this MUST
# be set — otherwise every request looks like it came from the proxy and one
# visitor exhausts the hourly budget for everybody.
#   0 or false — no proxy, talking to clients directly (default)
#   1          — exactly one proxy in front (the usual production setup)
# Avoid `true`: it trusts any X-Forwarded-For header, letting clients forge
# their own IP and bypass the limiters entirely.
TRUST_PROXY=false

# ── Seeding ─────────────────────────────────────────────────────────────────
# Required by `npm run seed` — there is no default. Minimum 12 characters.
SEED_ADMIN_PASSWORD=choose-a-strong-password-here
SEED_ADMIN_EMAIL=admin@iitdh.ac.in
# Re-running the seed keeps the existing admin password. Set this to true for
# one run to deliberately rotate it to SEED_ADMIN_PASSWORD.
SEED_RESET_ADMIN_PASSWORD=false

# Google OAuth (Student & Faculty Sign-In) — Web application Client ID from
# Google Cloud Console. Not a secret; safe to be public in a frontend build.
# Sign-in is restricted to @iitdh.ac.in accounts; an address listed in the
# faculty directory signs in as faculty, everyone else as a student.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── Exported spreadsheets ────────────────────────────────────────────────────
# Public HTTP origin of this API. Document links written into exported Excel
# files are absolute, so this must be the address a browser can reach — NOT the
# database URL. Defaults to http://localhost:$PORT.
PUBLIC_API_BASE_URL=http://localhost:3000
# How long a document link in a downloaded spreadsheet keeps working.
EXPORT_LINK_TTL_DAYS=30

# ── Reminder emails (expiring visas, passports, MOUs) ────────────────────────
# All optional. With SMTP_HOST unset the daily scan still records notifications
# in the admin panel — it just cannot send the digest.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=iro@iitdh.ac.in
# Overrides the IRO_OFFICE contact as the reminder recipient.
IRO_NOTIFICATION_EMAIL=
# Daily expiry sweep, in Asia/Kolkata. Default: 07:00 every day.
REMINDER_CRON=0 7 * * *
